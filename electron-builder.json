{
  "appId": "com.dinosour.web.desktop",
  "productName": "Dinosour Web",
  "artifactName": "DinosourWeb-Setup-${version}.${ext}",
  "directories": { "output": "dist" },
  "files": [
    "desktop/main.cjs", "desktop/THIRD_PARTY_NOTICES.md", "server.js", "youtube-search.js", "audio-formats.js",
    "public/**/*", "!public/download/**/*", "package.json",
    "android/COPYING", "android/THIRD_PARTY_NOTICES.md"
  ],
  "extraResources": [{ "from": "desktop/runtime", "to": "runtime" }],
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "public/icons/icon-512.png", "signExecutable": false },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Dinosour Web",
    "deleteAppDataOnUninstall": false
  }
}
